# --- Dependencies -------------------------------------------------------------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build output -------------------------------------------------------------
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# --- Testing ------------------------------------------------------------------
/coverage
/playwright-report/
/test-results/

# --- Secrets & local config (NEVER commit) ------------------------------------
# Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.secret

# --- Vercel / tooling ---------------------------------------------------------
.vercel
.turbo

# --- Prisma -------------------------------------------------------------------
# Generated client; recreate with `npx prisma generate`
/lib/generated/prisma
prisma/*.db
prisma/*.db-journal

# --- Logs & debug -------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Editors / IDEs -----------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo
*~

# --- AI assistant local state -------------------------------------------------
.claude/
.gemini/
.cursor/

# --- OS files -----------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- Scratch ------------------------------------------------------------------
tmp/
*.tmp